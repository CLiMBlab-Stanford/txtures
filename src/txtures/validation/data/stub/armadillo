// Minimal stand-in for armadillo: ModelBlocks' Delimited.hpp includes it only
// for Delimited<Col>, which ccmodel2synproccptmodel does not use.
#include <vector>
#include <cstddef>
namespace arma {
namespace fill { struct zeros_t {}; static const zeros_t zeros = {}; }
template <class T> class Col : public std::vector<T> {
 public:
  Col() {}
  Col(std::size_t n, fill::zeros_t) : std::vector<T>(n) {}
  std::size_t n_elem = 0;
};
template <class T> class Mat : public std::vector<T> {
 public:
  Mat() {}
  Mat(std::size_t r, std::size_t c) : std::vector<T>(r * c), n_rows(r), n_cols(c) {}
  std::size_t n_rows = 0, n_cols = 0;
};
}
